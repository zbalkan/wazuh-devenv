{
    // Example VS Code debug configurations for the package-based workflow.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "wazuhdevenv: help",
            "type": "debugpy",
            "request": "launch",
            "module": "wazuhdevenv",
            "console": "integratedTerminal",
            "args": [
                "--help"
            ]
        },
        {
            "name": "wazuhdevenv: update --check",
            "type": "debugpy",
            "request": "launch",
            "module": "wazuhdevenv",
            "console": "integratedTerminal",
            "args": [
                "update",
                "--check"
            ]
        },
        {
            "name": "Package unit tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "args": [
                "-v",
                "tests"
            ]
        },
        {
            "name": "Current pytest file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "args": [
                "-v",
                "${file}"
            ]
        }
    ]
}
